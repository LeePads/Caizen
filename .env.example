# Optional integrations. Leave values empty for core local-only use.
# Public client configuration: never use a Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TMDB_API_KEY=

# Server-only credentials for the hosted Next.js API routes.
RAWG_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional credential-free HTTPS origin hosting Caizen's API routes for Android.
# Production/release APK: https://caizen.space
# Development APK: https://caizenlife.vercel.app
NEXT_PUBLIC_APP_URL=

# Website metadata origin, independent of Android API configuration.
# Default/production: https://caizen.space
# Set staging explicitly to https://caizenlife.vercel.app (noindex).
NEXT_PUBLIC_SITE_URL=

# Optional: require Cloud configuration during Android builds.
# CAIZEN_REQUIRE_CLOUD=1
