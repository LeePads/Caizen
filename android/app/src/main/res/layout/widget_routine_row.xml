<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_routine_body"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="1dp"
    android:background="@drawable/widget_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="0dp">
    <TextView
        android:id="@+id/widget_routine_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="&#10003;"
        android:textColor="@color/caizen_widget_accent"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp">
        <TextView
            android:id="@+id/widget_routine_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/caizen_widget_foreground"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_routine_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/caizen_widget_muted"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_routine_complete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_routine_action"
        android:contentDescription="@string/widget_routines_complete"
        android:gravity="center"
        android:text="&#10003;"
        android:textColor="@color/caizen_widget_on_accent"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
