{
  "name": "caizen-life-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:android-env": "node scripts/check-android-env.mjs",
    "configure:android-test-signing": "node scripts/configure-android-test-signing.mjs",
    "test:android-mobile": "node scripts/android-mobile-smoke.mjs",
    "test:android-performance": "node scripts/android-performance-smoke.mjs",
    "test:android-phase16": "node scripts/android-phase16-smoke.mjs",
    "test:android-phase17a": "node scripts/android-phase17a-smoke.mjs",
    "test:android-phase18": "node scripts/android-phase18-visual.mjs",
    "test:android-tokens": "node scripts/android-token-audit.mjs",
    "test:android-calendar": "node scripts/android-calendar-audit.mjs",
    "test:android-keyboard": "node scripts/android-keyboard-audit.mjs",
    "test:android-import-preview": "node scripts/android-import-preview-shot.mjs",
    "test:android-uiux": "node scripts/android-uiux-audit.mjs",
    "test:android-audit17": "node scripts/audit17-responsive-smoke.mjs",
    "test:android-static": "node scripts/android-static-smoke.mjs",
    "test:web-activation": "node scripts/web-activation-smoke.mjs",
    "test:lifehub-release": "node scripts/lifehub-release-audit.mjs",
    "test:landing-scroll": "node scripts/landing-scroll-smoke.mjs",
    "check:android-export-boundary": "node scripts/build-android-web.mjs --verify-only",
    "build:android:web": "pnpm check:android-env && node scripts/build-android-web.mjs",
    "cap:sync": "pnpm build:android:web && cap sync android",
    "android:build": "pnpm android:debug",
    "android:open": "cap open android",
    "android:debug": "node scripts/android-gradle.mjs assembleDebug",
    "android:release:apk": "pnpm cap:sync && node scripts/android-gradle.mjs assembleRelease",
    "android:release:aab": "pnpm cap:sync && node scripts/android-gradle.mjs bundleRelease",
    "android:assets": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor #07111f --iconBackgroundColorDark #07111f --splashBackgroundColor #07111f --splashBackgroundColorDark #07111f",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:android:web"
  },
